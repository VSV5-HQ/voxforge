{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile storing non-sensitive account metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User full display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "User email address."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp (Firestore server timestamp)."
        }
      },
      "required": ["uid", "fullName", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile documents accessible and modifiable only by the owning user."
    }
  }
}
